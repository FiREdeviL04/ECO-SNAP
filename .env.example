# Required for real, signed Cloudinary uploads. Never expose the secret in client code.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Use a dedicated upload folder name; defaults to ecosnap/reports.
CLOUDINARY_UPLOAD_FOLDER=ecosnap/reports
# Optional: enables persistent reports through Supabase REST.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
